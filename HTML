<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>HashTable Demo | Your Name</title>
  <link rel="stylesheet" href="styles.css" />
</head>
<body>
  <header>
    <h1>Mastering Data Structures: HashTable Showcase</h1>
    <p>Built with HTML, CSS, and JavaScript | Impressing Companies & Developers</p>
  </header>
  
  <section class="intro">
    <h2>Unlocking the Power of Hash Tables</h2>
    <p>Explore my custom implementation of a hash table — showcasing core operations, collision handling, and real-time interaction.</p>
  </section>
  
  <section class="demo">
    <div class="hash-table-container">
      <h3>Hash Table Visualization</h3>
      <div id="hashTableDisplay" class="hash-table"></div>
    </div>
    
    <div class="controls">
      <h3>Interact with HashTable</h3>
      <div class="input-group">
        <input type="text" id="keyInput" placeholder="Key" />
        <input type="text" id="valueInput" placeholder="Value" />
      </div>
      <div class="buttons">
        <button id="addBtn">Add</button>
        <button id="removeBtn">Remove</button>
        <button id="lookupBtn">Lookup</button>
      </div>
      <div id="result" class="result"></div>
    </div>
  </section>
  
  <footer>
    <p>Created by Your Name | Passionate about Data Structures & Algorithm Excellence</p>
  </footer>

  <script src="script.js"></script>
</body>
</html>
